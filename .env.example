# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no repositório

# Chave secreta do Flask (sessões, CSRF). Gere uma forte com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# False em produção
DEBUG=False

# Dev: sqlite:///football.db
# Produção (Railway/Render): postgresql://usuario:senha@host:5432/futsal_db
DATABASE_URL=sqlite:///football.db

# Credenciais do organizador (única conta administrativa do sistema)
ADMIN_USERNAME=admin
# Gere o hash da senha com:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('SUA_SENHA_AQUI'))"
ADMIN_PASSWORD_HASH=
